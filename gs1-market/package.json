{
  "name": "gs1-market",
  "version": "0.1.0",
  "private": true,
  "description": "GS1 Market - La Carrera de Escaneo",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "electron:dev": "vite build && electron .",
    "preview": "vite preview",
    "electron:build": "npm run build && electron-builder --win --x64",
    "electron:zip": "npm run build && electron-builder --win zip --x64"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/plus-jakarta-sans": "^5.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "bwip-js": "^4.11.4",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.475.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "author": "GS1 Venezuela",
  "build": {
    "appId": "org.gs1ve.gs1market",
    "productName": "GS1 Market",
    "copyright": "GS1 Venezuela",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GS1 Market",
      "artifactName": "GS1-Market-Setup-${version}.${ext}"
    },
    "artifactName": "GS1-Market-Portable-${version}.${ext}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anniustar2002-star/Proyecto-Eventoretailv2.git"
  }
}
